@model ETCAdminUI.Models.UserInfoModel

@{
    /**/

    ViewBag.Title = "Branch Check";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}


<div class="bg-light form-signin" style="width:350px;">
    <h5 class="text-center" style="color:#2e5495;">
        Branch Check
    </h5>
    <hr/>
    <div class="card-body" style="padding-left:25px;">
        @using (Html.BeginForm("BranchCheck", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @if (ViewBag.BranchStat != null && !ViewBag.BranchStat)
                {                    
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Wrong Branch Code</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div>
                    <label class="col-form-label">Branch Code</label>
                    @Html.EditorFor(m => m.UserBRCode, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.UserBRCode, "", new { @class = "text-danger" })
                </div>

                <div class="my-2 d-flex justify-content-between">
                    <div class="mr-2"><input type="submit" value="Proceed" class="btn btn-primary px-5" /></div>
                    <div class=""><a class="btn btn-secondary px-3" href="@Url.Action("Logout", "Account")">Logout</a></div>
                </div>
            </div>
        }
    </div>

    <p class="login-footer">&copy; @DateTime.Now.Year - Sonali Bank PLC.</p>
</div>

