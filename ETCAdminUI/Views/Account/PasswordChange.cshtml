@model ETCAdminUI.Models.ChangePasswordModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Change Password";
}

<!-- ফন্ট-অসাম আইকনের জন্য সিডিএন লিংক যুক্ত করা হলো -->
<link rel="stylesheet" href="https://cloudflare.com" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <!-- মেইন এস্থেটিক কার্ড কন্টেইনার -->
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top">
                    <h3 class="mb-1 fw-bold"><i class="fas fa-key me-2"></i> @ViewBag.Title</h3>
                    <p class="mb-0 text-white-50 small">Update your account password to stay secure</p>
                </div>

                <div class="card-body p-4">

                    <!-- এরর মেসেজ অ্যালার্ট ব্যানার -->
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                        <!-- ১. বর্তমান পাসওয়ার্ড ইনপুট ফিল্ড -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">Current Password</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control border-start-0 ps-0", placeholder = "Enter current password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- ২. নতুন পাসওয়ার্ড ইনপুট ফিল্ড -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">New Password</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock-open text-muted"></i></span>
                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control border-start-0 ps-0", placeholder = "Enter new password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- ৩. নতুন পাসওয়ার্ড কনফার্মেশন ফিল্ড -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary">Confirm New Password</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-check-double text-muted"></i></span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control border-start-0 ps-0", placeholder = "Re-type new password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- সাবমিট ও ক্যানসেল বাটন গ্রুপ -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fs-6 fw-bold shadow-sm py-2">
                                <i class="fas fa-save me-2"></i> Save Password
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-sm text-muted text-center border-0 mt-2">
                                Cancel & Go Back
                            </a>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
