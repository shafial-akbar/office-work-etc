@using System.Text.Json
@inject IHttpContextAccessor Accessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ePostTran</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ePostTran.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            UserInfoModel objUserInfo = new UserInfoModel();
            Boolean loginStatus = false;
            var json = Accessor.HttpContext.Session.GetString("loginStatus");
            if (!string.IsNullOrEmpty(json))
            {
                objUserInfo = JsonSerializer.Deserialize<UserInfoModel>(json);
                loginStatus = objUserInfo.IsActive;
            }
        }
        <nav class="navbar navbar-expand-lg navbar-light navbar-dark bg-menu">
            <div class="container-fluid">
                @* <a class="navbar-brand" href="#">Dashboard</a> *@
                <a class="navbar-brand" href="#"><img src="~/images/logo.png" width="30" height="24" />ePostTran System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", new { Area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("About", "About", "Home", new { Area = "" }, new { @class = "nav-link" })</li>                        
                    </ul>
                    @if (loginStatus)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @objUserInfo.UserId - @objUserInfo.UserRoleName (BR-@objUserInfo.UserBRCode)
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <li>@Html.ActionLink("Password Change", "PasswordChange", "Account", new { Area = "" }, new { @class = "dropdown-item" })</li>
                                    <li><hr class="dropdown-divider" style="height:0px;" /></li>
                                    <li>@Html.ActionLink("Logout", "Logout", "Account", new { Area = "" }, new { @class = "dropdown-item" })</li>
                                    @* <li><a class="dropdown-item" href="#">Something else here</a></li> *@
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="btn btn-sm btn-warning px-5 nav-item" href="/"><b>Login</b></a>
                            </li>
                        </ul>

                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ePostTran - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
